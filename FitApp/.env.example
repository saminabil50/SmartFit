# Copy this file to .env and fill in real values (never commit .env)

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fitApp
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT — use a long random string (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string_here

# AI server (Python FastAPI — see ai_server/)
AI_SERVER_URL=http://127.0.0.1:9000

# fal.ai virtual try-on
FAL_KEY=your_fal_key_here
TRYON_PROVIDER=fal
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.5
FAL_TRYON_CATEGORY=auto
FAL_TRYON_MODE=quality
FAL_GARMENT_PHOTO_TYPE=auto
FAL_MODERATION_LEVEL=permissive
FAL_NUM_SAMPLES=1
FAL_SEGMENTATION_FREE=true
FAL_OUTPUT_FORMAT=png
